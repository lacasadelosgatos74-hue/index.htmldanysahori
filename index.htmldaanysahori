<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sahori</title>
<style>
:root {
  --pink-main: #e88ab1;
  --pink-light: #fdf0f5;
  --pink-soft: #f7cedc;
  --blue-main: #73a9c2;
  --blue-light: #eff6fa;
  --blue-soft: #b2d5e5;
  --ink: #4f3b47;
  --ink-light: #7a6371;
  --line: #f1cbd8;
  --white: #ffffff;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff9fb 0%, #f4f8fb 100%);
  color: var(--ink);
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  overflow-x: hidden;
  position: relative;
}

.page {
  min-height: 100vh;
  position: relative;
  isolation: isolate;
  padding: 40px 16px 50px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.page::before, .page::after {
  content: "";
  position: fixed;
  top: 0;
  bottom: 0;
  width: clamp(25px, 8vw, 80px);
  pointer-events: none;
  z-index: -1;
  opacity: 0.85;
  background-image: 
    radial-gradient(circle at 50% 20px, #f4b6cc 0 4px, transparent 5px),
    radial-gradient(circle at 20% 60px, #aed4e6 0 3px, transparent 4px),
    radial-gradient(circle at 70% 100px, #f7d0dc 0 5px, transparent 6px),
    radial-gradient(circle at 35% 150px, #8bbcd3 0 3px, transparent 4px);
  background-size: 60px 180px;
}

.page::before { left: 0; }
.page::after { right: 0; transform: scaleX(-1); }

.topline, .bottomline {
  width: min(100%, 720px);
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--pink-soft), var(--blue-soft), transparent);
}

.topline { margin-bottom: 25px; }
.bottomline { margin-top: 35px; }

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 3px;
  font-size: 11px;
  color: var(--pink-main);
  text-align: center;
  margin-bottom: 12px;
  font-weight: 600;
}

.lotus-icon {
  font-size: 38px;
  line-height: 1;
  margin-bottom: 12px;
  background: linear-gradient(135deg, var(--pink-main), var(--blue-main));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
  animation: floatLotus 4s ease-in-out infinite;
}

@keyframes floatLotus {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-6px) rotate(3deg); }
}

h1 {
  text-align: center;
  font-size: clamp(32px, 7vw, 48px);
  font-weight: 600;
  letter-spacing: 0.5px;
  color: #b85f7e;
  margin-bottom: 8px;
}

.subtitle {
  text-align: center;
  font-size: 14px;
  line-height: 1.8;
  color: var(--ink-light);
  margin-bottom: 30px;
}

/* TIMER */
.timer-card {
  width: min(100%, 650px);
  background: linear-gradient(135deg, rgba(253, 240, 245, 0.9), rgba(239, 246, 250, 0.9));
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 24px;
  margin-bottom: 30px;
  text-align: center;
  box-shadow: 0 10px 30px rgba(180, 120, 150, 0.06);
}

.timer-card h3 {
  font-size: 18px;
  color: #a85575;
  margin-bottom: 6px;
  font-weight: 600;
}

.timer-card .startDateText {
  font-size: 12px;
  color: var(--ink-light);
  margin-bottom: 18px;
}

.timer-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  max-width: 500px;
  margin: 0 auto;
}

.timer-box {
  background: #ffffff;
  border-radius: 12px;
  padding: 12px 6px;
  border: 1px solid rgba(220, 160, 182, 0.3);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.02);
}

.timer-box .number {
  font-size: clamp(20px, 5vw, 28px);
  font-weight: 600;
  color: #b85f7e;
  line-height: 1.1;
}

.timer-box .label {
  font-size: 11px;
  color: #7a6371;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-top: 4px;
}

/* LETTER */
.card {
  width: min(100%, 650px);
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: clamp(23px, 6vw, 42px);
  box-shadow: 0 14px 45px rgba(164, 92, 119, 0.09);
  position: relative;
  margin-bottom: 30px;
}

.card h2 {
  text-align: center;
  font-weight: 600;
  font-size: 24px;
  color: #b85f7e;
  margin-bottom: 25px;
}

.letter {
  font-size: 15px;
  line-height: 1.95;
  color: #58414b;
  text-align: left;
}

.letter p {
  margin-bottom: 18px;
}

.letter p:last-child {
  margin-bottom: 0;
}

.letter strong {
  font-weight: 600;
  color: #b85f7e;
}

/* MEANING CARD */
.meaning-card {
  width: min(100%, 650px);
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid #e3edf3;
  border-top: 3px solid var(--pink-main);
  border-bottom: 3px solid var(--blue-main);
  border-radius: 16px;
  padding: 28px 24px;
  box-shadow: 0 10px 30px rgba(120, 160, 180, 0.08);
  margin-bottom: 30px;
  text-align: center;
}

.meaning-card h3 {
  font-size: 19px;
  color: #a85575;
  margin-bottom: 14px;
  font-weight: 600;
}

.meaning-card p {
  font-size: 14.5px;
  line-height: 1.8;
  color: var(--ink-light);
  margin-bottom: 12px;
}

.meaning-pills {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-top: 18px;
}

.pill {
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 12px;
}

.pill-pink {
  background: var(--pink-light);
  color: #b85f7e;
  border: 1px solid var(--pink-soft);
}

.pill-blue {
  background: var(--blue-light);
  color: #48728a;
  border: 1px solid var(--blue-soft);
}

/* TEXT DECORATION AT BOTTOM */
.couple-signature {
  text-align: center;
  margin-top: 15px;
  padding: 20px 10px;
  width: min(100%, 650px);
}

.couple-names {
  font-size: 22px;
  letter-spacing: 4px;
  color: #b85f7e;
  font-weight: 500;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.couple-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: var(--blue-main);
  font-size: 12px;
  margin-bottom: 8px;
}

.couple-divider::before, .couple-divider::after {
  content: "";
  display: block;
  width: 40px;
  height: 1px;
  background: var(--blue-soft);
}

.couple-note {
  font-size: 12.5px;
  color: var(--ink-light);
  letter-spacing: 1px;
}

.signature {
  text-align: center;
  margin-top: 15px;
  color: #b77d91;
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.fall {
  position: fixed;
  top: -45px;
  left: 0;
  pointer-events: none;
  z-index: 5;
  animation: fall linear forwards;
  will-change: transform;
}

@keyframes fall {
  to {
    transform: translate3d(var(--drift), 110vh, 0) rotate(var(--spin));
    opacity: 0.15;
  }
}

@media(max-width: 480px) {
  .page { padding-left: 18px; padding-right: 18px; }
  .card { padding: 25px 20px; }
  .letter { font-size: 14.5px; line-height: 1.85; }
  .timer-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
}
</style>
</head>
<body>

<main class="page">
  <div class="topline"></div>
  <div class="eyebrow">Una historia escrita desde el corazón</div>
  <div class="lotus-icon" aria-hidden="true">🪷</div>
  
  <h1>Sahori</h1>
  <p class="subtitle">
    Un amor bonito a pesar de la distancia
  </p>

  <div class="timer-card">
    <h3>Llevamos juntos</h3>
    <div class="startDateText">Desde el 18 de enero de 2026 a las 10:39 a. m.</div>
    <div class="timer-grid">
      <div class="timer-box">
        <div id="dias" class="number">0</div>
        <div class="label">Días</div>
      </div>
      <div class="timer-box">
        <div id="horas" class="number">00</div>
        <div class="label">Horas</div>
      </div>
      <div class="timer-box">
        <div id="minutos" class="number">00</div>
        <div class="label">Minutos</div>
      </div>
      <div class="timer-box">
        <div id="segundos" class="number">00</div>
        <div class="label">Segundos</div>
      </div>
    </div>
  </div>

  <article class="card">
    <h2>Sahori</h2>
    <div class="letter">
      <p>
        Primero que nada quería darte las gracias por estar conmigo y que sepas que te amo en verdad y que no hay un solo día en el que no me sienta feliz de tenerte en mi vida aunque estemos lejos, lo que siento por ti es algo que nace de mi
      </p>
      <p>
        eres alguien con quien quiero seguir creando recuerdos alguien con quien quiero compartir mis risas y mis sueños
      </p>
      <p>
        sé que una relación a distancia no siempre es fácil que hay kilómetros que nos separan y momentos en los que seguramente vamos a extrañarnos demasiado pero cuando las cosas se pongan difíciles recordemos todo lo que sentimos y hablemos las veces que sean necesarias para entendernos
      </p>
      <p>
        Igual pedirte disculpas, no porque haya hecho algo malo, si no por el hecho de a veces hacerte enojar, perdón si alguna vez hice algo que te molestó, solo dime, prometo cambiarlo para siempre verte felíz y que nunca pienses algo malo sobre mi, porque recuerda que tu felicidad es la mia, te amo muchote sé que también puedo equivocarme pero sí quiero esforzarme por hacerte feliz por aprender de mis errores por escucharte y por demostrarte con hechos
      </p>
      <p>
        mi sueño es que algún día podamos abrazarnos por fin y sentir que cada día que esperamos valió la pena quiero vivir muchas cosas bonitas contigo y seguir conociéndote cada día un poquito más porque todavía hay muchísimas cosas que quiero descubrir de ti
      </p>
      <p>
        gracias por llegar a mi vida, cada momento que me me haces sonreír y por permitirme formar parte de la tuya si pudieras ver todo lo que siento por ti desde mi corazón entenderías por qué eres tan importante para mí y el por qué me hace tanta ilusión imaginar un futuro en el que sigamos juntos
      </p>
      <p>
        te amo en verdad mi vida nunca olvides que detrás de esta pagina hay alguien que piensa en ti que te extraña que sueña con abrazarte y que se siente muy afortunado
      </p>
      <p>
        Que sigamos construyendo algo bonito a nuestro ritmo sin dejar de hablar sin dejar de cuidarnos y sin olvidarnos de que somos dos personitas que decidieron darse una oportunidad a pesar de la distancia
      </p>
      <p>
        si vuelves a leer esta carta quiero que recuerdes que cada palabra la escribí pensando en ti
      </p>
      <p style="text-align: center; margin-top: 25px; padding-top: 15px; border-top: 1px solid var(--line);">
        <strong>te amo muchísimo mi vida, si pudiera elegir otra vez volvería a querer conocerte volvería a enamorarme de ti 💗🪷</strong>
      </p>
    </div>
  </article>

  <article class="meaning-card">
    <h3>El Significado de la Flor de Loto 🪷</h3>
    <p>
      La <strong>Flor de Loto</strong> es un símbolo puro de resiliencia, amor sincero y renacimiento. Florece con serenidad y belleza sobre cualquier agua, superando los obstáculos para desplegar sus pétalos más hermosos.
    </p>
    <p>
      Así como la flor de loto florece impecable, nuestro amor demuestra que no importa la distancia ni los kilómetros; el amor verdadero se cuida, crece fuerte y florece con más fuerza cada día.
    </p>
    <div class="meaning-pills">
      <span class="pill pill-pink">🌸 Rosa: Dulzura y Amor Sincero</span>
      <span class="pill pill-blue">🩵 Azul: Paz, Tranquilidad y Lealtad</span>
      <span class="pill pill-pink">🪷 Flor de Loto: Nuestro Amor que Supera Toda Distancia</span>
    </div>
  </article>

  <div class="couple-signature">
    <div class="couple-names">Daan & Sahori</div>
    <div class="couple-divider">🪷</div>
    <div class="couple-note">Paso a paso, un día a la vez.</div>
  </div>

  <div class="signature">Hecho especialmente desde el corazón para Sahori</div>
  <div class="bottomline"></div>
</main>

<script>
// Live Count-Up Timer since Jan 18, 2026 at 10:39 AM
const startDate = new Date(2026, 0, 18, 10, 39, 0); // Month 0 = Jan

function actualizarContador() {
  const ahora = new Date();
  const diferencia = ahora - startDate;

  if (diferencia < 0) {
    document.getElementById("dias").textContent = "0";
    document.getElementById("horas").textContent = "00";
    document.getElementById("minutos").textContent = "00";
    document.getElementById("segundos").textContent = "00";
    return;
  }

  const dias = Math.floor(diferencia / (1000 * 60 * 60 * 24));
  const horas = Math.floor((diferencia / (1000 * 60 * 60)) % 24);
  const minutos = Math.floor((diferencia / (1000 * 60)) % 60);
  const segundos = Math.floor((diferencia / 1000) % 60);

  document.getElementById("dias").textContent = dias;
  document.getElementById("horas").textContent = horas < 10 ? "0" + horas : horas;
  document.getElementById("minutos").textContent = minutos < 10 ? "0" + minutos : minutos;
  document.getElementById("segundos").textContent = segundos < 10 ? "0" + segundos : segundos;
}

setInterval(actualizarContador, 1000);
actualizarContador();

// Subtle falling petals animation
function lanzarDecoracion(cantidad) {
  const simbolos = ["🪷", "🌸", "✿"];
  const colores = ["#e88ab1", "#f7cedc", "#73a9c2", "#b2d5e5", "#d66b91"];
  
  for (let i = 0; i < cantidad; i++) {
    setTimeout(() => {
      const item = document.createElement("span");
      item.className = "fall";
      item.textContent = simbolos[Math.floor(Math.random() * simbolos.length)];
      item.style.left = Math.random() * 100 + "vw";
      item.style.fontSize = (14 + Math.random() * 16) + "px";
      item.style.color = colores[Math.floor(Math.random() * colores.length)];
      item.style.setProperty("--drift", (Math.random() * 160 - 80) + "px");
      item.style.setProperty("--spin", (Math.random() * 500 - 250) + "deg");
      item.style.animationDuration = (5 + Math.random() * 5) + "s";
      document.body.appendChild(item);
      setTimeout(() => item.remove(), 10500);
    }, i * 120);
  }
}

let decorTimer = setInterval(() => lanzarDecoracion(2), 2000);
setTimeout(() => clearInterval(decorTimer), 20000);
</script>
</body>
</html>
